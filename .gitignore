# ===========================================================================
# Stock Intelligence Pro — Production & Cloud .gitignore
# ===========================================================================

# Secrets & Environment Files (Never commit real credentials)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node & Frontend Dependencies & Build Output
node_modules/
dist/
frontend/dist/
.npm/
.eslintcache
.vite/

# Database Files & SQLite Ephemeral Artifacts
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.backup
backend/data/*.db
backend/stock_intelligence.db
backups/

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# Temporary Files, Logs & Bundles
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.zip
*.tar.gz
scratch/
