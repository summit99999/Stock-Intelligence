# ===========================================================================
# Stock Intelligence Pro — Root Project Environment Reference
# ===========================================================================

# Refer to backend/.env.example for FastAPI / Render backend settings.
# Refer to frontend/.env.example for Cloudflare Pages frontend settings.

# Backend (Render Free)
# PORT=8000
# ENVIRONMENT=production
# FRONTEND_ORIGIN=https://your-frontend.pages.dev
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[REF].supabase.co
# SUPABASE_ANON_KEY=[KEY]
# SUPABASE_JWT_SECRET=[SECRET]

# Frontend (Cloudflare Pages)
# VITE_API_BASE_URL=https://your-backend-app.onrender.com
# VITE_SUPABASE_URL=https://[REF].supabase.co
# VITE_SUPABASE_ANON_KEY=[KEY]
