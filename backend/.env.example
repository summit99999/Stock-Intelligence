# ===========================================================================
# Stock Intelligence Pro — Backend Environment Configuration Template
# Safe placeholder template. NEVER commit real credentials to Git.
# ===========================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL Database (Transaction or Session Pooler)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When empty or omitted, the application automatically falls back to local SQLite.
DATABASE_URL=

# Supabase Auth & JWT Verification
# Obtain from: Supabase Dashboard -> Project Settings -> API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-backend-verification
# Backend-only Service Role Key (NEVER expose to frontend code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Data Mode & Provider Selection
DATA_MODE=historical
MARKET_DATA_PROVIDER=yfinance

# Dhan Broker Credentials (Optional, live market feed remains disabled by default)
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_API_BASE_URL=https://api.dhan.co
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_REDIRECT_URL=http://127.0.0.1:8000/api/dhan/oauth/callback
DHAN_LIVE_DATA_ENABLED=false

# Upstox API Credentials (Optional)
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com
