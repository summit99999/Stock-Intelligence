alertcondition(eql_alert,          title="Equal Lows (EQL) Liquidity",  message="[Liquidity] Equal Lows (EQL) pool formed on {{ticker}} ({{interval}})")
alertcondition(powerbar_alert,     title="PowerBar Momentum Signal",    message="[PowerBar] Momentum Bar detected on {{ticker}} ({{interval}})")
alertcondition(pb_bull_alert,      title="Bullish PowerBar (Purple)",   message="[PowerBar] Bullish Purple Momentum Bar detected on {{ticker}} ({{interval}})")
alertcondition(pb_bear_alert,      title="Bearish PowerBar (Deep Brown)", message="[PowerBar] Bearish Deep Brown Momentum Bar detected on {{ticker}} ({{interval}})")
alertcondition(pocket_pivot_alert, title="Pocket Pivot Signal",         message="[Pocket Pivot] Volume Lens Pocket Pivot detected on {{ticker}} ({{interval}})")
alertcondition(rvol_alert,         title="High Relative Volume (RVol)", message="[RVol] High Relative Volume surge detected on {{ticker}} ({{interval}})")
alertcondition(fib_hit_05,         title="Price Retraced to 0.50 Fib",  message="[Fib] Price retraced to 0.50 Equilibrium level on {{ticker}} ({{interval}})")
alertcondition(fib_hit_618,        title="Price Retraced to 0.618 Fib", message="[Fib] Price retraced to 0.618 Golden Pocket level on {{ticker}} ({{interval}})")
