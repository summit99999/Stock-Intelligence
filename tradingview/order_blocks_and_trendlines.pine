range_gold_color    = input.color(color.new(#ff9800, 20), "0.618 Golden Pocket Line Color", group=grp_range)

// --- 10. Session Point of Control (POC) ---
grp_poc             = "10. Session Point of Control (POC)"
show_poc            = input.bool(true, "Enable Point of Control (POC)", group=grp_poc)
poc_lookback        = input.int(20, "POC Lookback Bars", minval=10, maxval=100, group=grp_poc)
