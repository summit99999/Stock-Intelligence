fvg_max_active      = input.int(8, "Max Active FVGs (Per Side)", minval=1, maxval=25, group=grp_fvg)
fvg_extend_bars     = input.int(8, "Base FVG Extension (Bars)", minval=0, maxval=50, group=grp_fvg)
bull_fvg_color      = input.color(color.new(#183b23, 78), "Bullish FVG Background", group=grp_fvg)
bull_fvg_border     = input.color(color.new(#089981, 30), "Bullish FVG Border", group=grp_fvg)
