tl_show_breaks      = input.bool(true, "Show Breakout / Breakdown Signals", group=grp_tl)
tl_extend_bars      = input.int(30, "Trendline Forward Projection (Bars)", minval=5, maxval=100, group=grp_tl)
tl_max_active       = input.int(2, "Max Active Lines (Per Side)", minval=1, maxval=5, group=grp_tl)
tl_res_color        = input.color(color.new(#f23645, 20), "Resistance Trendline Color", group=grp_tl)
tl_sup_color        = input.color(color.new(#089981, 20), "Support Trendline Color", group=grp_tl)

// --- 8. Flat Consolidation Range ---
grp_range           = "8. Flat Consolidation Range (Volume Lens Style)"
show_flat_range     = input.bool(true, "Enable Flat Range Box", group=grp_range)
range_min_bars      = input.int(20, "Range Lookback Length (Bars)", minval=10, maxval=100, group=grp_range)
range_max_spread_pct= input.float(12.0, "Max Range Spread (%)", minval=1.0, maxval=50.0, step=0.5, group=grp_range)
range_currency      = input.string("₹", "Price Currency Symbol", group=grp_range)
range_box_color     = input.color(color.new(#787b86, 92), "Range Box Fill Color", group=grp_range)
