//@version=6
// Indicator: SMC Community Pro: OB, FVG, HTF TL, Range, POC, Fib, Volume Candles, PowerBar, Pocket Pivot, RVol & Multi-TF Returns
indicator("SMC Community Pro: OB, FVG, Range, POC, Fib, VolCandles & Dashboard", shorttitle="SMC+PRO", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================================================
// 1. INPUT SETTINGS
// =============================================================================

// --- 1. Market Structure & Pivots ---
grp_pivots          = "1. Market Structure & Pivots (BOS / CHoCH)"
p_left              = input.int(5, "Pivot Left Bars", minval=1, maxval=50, group=grp_pivots)
p_right             = input.int(5, "Pivot Right Bars", minval=1, maxval=50, group=grp_pivots)
show_swing_labels   = input.bool(false, "Show HH / LH / HL / LL Labels", group=grp_pivots)
show_bos            = input.bool(true, "Show Break of Structure (BOS)", group=grp_pivots)
show_choch          = input.bool(true, "Distinguish CHoCH vs BOS", group=grp_pivots)
show_crossed_mark   = input.bool(true, "Show Mitigated / Broken Marker (✖)", group=grp_pivots)

// --- 2. Strong & Weak Swing Levels ---
grp_sw              = "2. Strong & Weak Swing Levels (Institutional Targets)"
show_strong_weak    = input.bool(true, "Show Strong / Weak Swing High & Low", group=grp_sw)
color_strong        = input.color(#f23645, "Strong Swing Level Color", group=grp_sw)
color_weak          = input.color(#089981, "Weak Swing Level Color", group=grp_sw)

// --- 3. Order Blocks (OB) ---
grp_obs             = "3. Order Blocks (OB)"
show_obs            = input.bool(true, "Enable Order Blocks", group=grp_obs)
ob_vol_calc         = input.string("Active Zones Share (Algoat 100% Sum)", "Volume % Basis", options=["Active Zones Share (Algoat 100% Sum)", "100-Bar Rolling Volume"], group=grp_obs)
ob_zone_type        = input.string("Full (Wick-to-Wick)", "OB Boundary", options=["Full (Wick-to-Wick)", "Refined (Body-to-Wick)"], group=grp_obs)
ob_mit_type         = input.string("Touch (Wick)", "Mitigation Condition", options=["Touch (Wick)", "50% Equilibrium", "Close Inside Zone"], group=grp_obs)
ob_mit_action       = input.string("Style as Mitigated (Extend to Right)", "Action on Mitigation", options=["Style as Mitigated (Extend to Right)", "Stop Box at Touch", "Remove Box"], group=grp_obs)
ob_max_active       = input.int(8, "Max Active OBs (Per Side)", minval=1, maxval=25, group=grp_obs)
ob_extend_bars      = input.int(8, "Base Box Extension (Bars)", minval=0, maxval=50, group=grp_obs)
bull_ob_color       = input.color(color.new(#454954, 80), "Bullish OB Background", group=grp_obs)
bull_ob_border      = input.color(color.new(#787b86, 30), "Bullish OB Border", group=grp_obs)
bear_ob_color       = input.color(color.new(#5a272d, 78), "Bearish OB Background", group=grp_obs)
bear_ob_border      = input.color(color.new(#f23645, 30), "Bearish OB Border", group=grp_obs)

// --- 4. Fair Value Gaps (FVG) ---
grp_fvg             = "4. Fair Value Gaps (FVG)"
