// --- 7. Anti-Collision & Number Layout Engine ---
grp_anticol         = "7. Anti-Collision & Number Layout"
enable_anti_overlap = input.bool(true, "Enable Anti-Collision for Labels & Numbers", group=grp_anticol)

// --- 8. Smart HTF Auto Trendlines ---
grp_tl              = "8. Smart HTF Auto Trendlines"
