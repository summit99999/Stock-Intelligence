# ===========================================================================
# Stock Intelligence Pro — Frontend Environment Configuration Template
# Safe placeholder template for Cloudflare Pages / local development.
# Only public/browser-safe variables starting with VITE_ are permitted here.
# NEVER put the Supabase service_role key or backend secrets in this file.
# ===========================================================================

# Backend API Endpoint URL
# In local development: http://127.0.0.1:8000
# In production on Cloudflare Pages: https://your-backend-app.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth Client Configuration (Browser-Safe Anon Key)
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-browser-anon-publishable-key
