{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stock-intelligence-api-2esm.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://stock-intelligence-api-2esm.onrender.com/ws/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
